# Copy to .env and fill in. Never commit .env.

# Public address of this server. With no domain, use your server IP with sslip.io, e.g. 140.238.1.2.sslip.io
DOMAIN=140.238.1.2.sslip.io

# Long random values: generate each with   openssl rand -hex 32
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-64-random-hex-characters-please-xxxxxxxxxxxxxxxxxx
ADMIN_TOKEN=change-me-too

# Your Google Gemini API key (https://aistudio.google.com/apikey). It stays on this server only.
GEMINI_API_KEY=

# Google Cloud Speech-to-Text and Text-to-Speech (optional, for the "Google Cloud voice" mode in the app).
# In https://console.cloud.google.com create an API key in a project with billing, enable "Cloud Speech-to-Text API"
# and "Cloud Text-to-Speech API", and restrict the key to those two APIs. It stays on this server only.
GOOGLE_CLOUD_API_KEY=
# Recognition model and voices. Check https://cloud.google.com/text-to-speech/docs/voices before changing.
GOOGLE_STT_MODEL=latest_short
GOOGLE_TTS_VOICE_TA=ta-IN-Chirp3-HD-Aoede
GOOGLE_TTS_VOICE_EN=en-IN-Chirp3-HD-Aoede
GOOGLE_TTS_RATE=1

# OpenRouter for Stocky's typed conversation (optional): key from https://openrouter.ai/keys
# When set, it is used instead of Gemini for text. Real-time voice (Gemini Live) still needs GEMINI_API_KEY;
# without it the app uses "Server voice" or the phone's speech instead.
OPENROUTER_API_KEY=
# openrouter/free picks a free model that supports tools. Name a model for steadier Tamil/Tanglish, e.g. a paid one.
OPENROUTER_MODEL=openrouter/free
# auto (OpenRouter if its key is set, else Gemini), openrouter or gemini
TEXT_PROVIDER=auto

# Sarvam AI speech-to-text (optional, recommended for Tamil): key from https://dashboard.sarvam.ai
# When set, Sarvam hears the owner and Google Cloud (if set above) only reads replies aloud.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
# codemix = Tamil words in Tamil script, English words (stock, bill, XL) in English. Other options: transcribe, translit.
SARVAM_STT_MODE=codemix
# auto (Sarvam if its key is set, else Google), sarvam or google
STT_PROVIDER=auto
# Sarvam also reads Stocky's replies aloud (Bulbul voices, natural Tamil). Tamil voices on bulbul:v4-flash include
# gokul_ta_narration, vijay_ta_narration, aravind_ta_ads. TTS_PROVIDER: auto, sarvam or google.
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_SPEAKER_TA=gokul_ta_narration
SARVAM_TTS_PACE=1.05
TTS_PROVIDER=auto
# Without Sarvam or Google Cloud (or with STT_PROVIDER=gemini / TTS_PROVIDER=gemini), Gemini itself hears and speaks,
# using GEMINI_API_KEY only. The TTS model is found automatically; voices include Kore, Puck, Charon, Aoede, Leda.
GEMINI_TTS_VOICE=Kore

# Whisper speech-to-text on this server's own CPU (free, unlimited, private). Turn on with: bash enable-whisper.sh
# (it sets the next lines). Models: small (fast, weaker Tamil), medium (better Tamil, ~4 cores), large-v3 (best, slow on CPU).
WHISPER_URL=
WHISPER_MODEL=auto
COMPOSE_PROFILES=

# Models are chosen here, not in the app. Check https://ai.google.dev/gemini-api/docs/models before changing.
GEMINI_TEXT_MODEL=gemini-flash-lite-latest
GEMINI_LIVE_MODEL=gemini-3.8-live

# Longest single voice session in seconds (Google allows about 15 minutes of audio per session).
LIVE_MAX_SECONDS=600
TRIAL_DAYS=14
ALLOW_REGISTRATION=true
