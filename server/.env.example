# Copy to .env and fill in. Never commit .env.

# Public address of this server. With no domain, use your server IP with sslip.io, e.g. 140.238.1.2.sslip.io
DOMAIN=140.238.1.2.sslip.io

# Long random values: generate each with   openssl rand -hex 32
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-64-random-hex-characters-please-xxxxxxxxxxxxxxxxxx
ADMIN_TOKEN=change-me-too

# Your Google Gemini API key (https://aistudio.google.com/apikey). It stays on this server only.
GEMINI_API_KEY=

# OpenRouter for Stocky's typed conversation (optional): key from https://openrouter.ai/keys
# When set, it is used instead of Gemini for text. Real-time voice (Gemini Live) still needs GEMINI_API_KEY;
# without it the app uses "Server voice" or the phone's speech instead.
OPENROUTER_API_KEY=
# openrouter/free picks a free model that supports tools. Name a model for steadier Tamil/Tanglish, e.g. a paid one.
OPENROUTER_MODEL=openrouter/free
# auto (OpenRouter if its key is set, else Gemini), openrouter or gemini
TEXT_PROVIDER=auto

# Speech: Gemini hears the owner and speaks Stocky's replies with GEMINI_API_KEY (nothing else needed). Each owner picks
# Stocky's voice in the app (Settings > Stocky's voice); GEMINI_TTS_VOICE is the voice until they pick one.
# STT_PROVIDER: gemini (default) or whisper (after bash enable-whisper.sh). If Gemini is rate limited, Whisper hears instead.
STT_PROVIDER=gemini
GEMINI_TTS_VOICE=Kore

# Whisper speech-to-text on this server's own CPU (free, unlimited, private). Turn on with: bash enable-whisper.sh
# (it sets the next lines). Models: small (fast, weaker Tamil), medium (better Tamil, ~4 cores), large-v3 (best, slow on CPU).
WHISPER_URL=
WHISPER_MODEL=auto
COMPOSE_PROFILES=

# Models are chosen here, not in the app. Check https://ai.google.dev/gemini-api/docs/models before changing.
GEMINI_TEXT_MODEL=gemini-flash-lite-latest
GEMINI_LIVE_MODEL=gemini-3.8-live

# Longest single voice session in seconds (Google allows about 15 minutes of audio per session).
LIVE_MAX_SECONDS=600
TRIAL_DAYS=14
ALLOW_REGISTRATION=true

# Payments after the free trial (TRIAL_DAYS, default 14). Owners pay this UPI ID from the app and send the transaction
# ID; you check it in your UPI/bank app and run ./scripts.sh payments, then ./scripts.sh approve <#>.
UPI_ID=
UPI_NAME=Thodar
SUPPORT_PHONE=

# "Forgot password" emails (optional). Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_USER=you@gmail.com
# SMTP_PASS=<16-letter app password from myaccount.google.com/apppasswords>. Without these, run
# ./scripts.sh reset-code owner@email.com and tell the owner the code.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Cards, net banking and UPI through Razorpay (optional; needs your Razorpay account and KYC).
# Dashboard > Account & Settings > API Keys. With these set, the plan starts by itself when the owner pays.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
