# Copy to .env and fill in. Never commit .env.

# Public address of this server. With no domain, use your server IP with sslip.io, e.g. 140.238.1.2.sslip.io
DOMAIN=140.238.1.2.sslip.io

# Long random values: generate each with   openssl rand -hex 32
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-64-random-hex-characters-please-xxxxxxxxxxxxxxxxxx
ADMIN_TOKEN=change-me-too

# Your Google Gemini API key (https://aistudio.google.com/apikey). It stays on this server only.
GEMINI_API_KEY=

# Models are chosen here, not in the app. Check https://ai.google.dev/gemini-api/docs/models before changing.
GEMINI_TEXT_MODEL=gemini-flash-latest
GEMINI_LIVE_MODEL=gemini-3.8-live

# Longest single voice session in seconds (Google allows about 15 minutes of audio per session).
LIVE_MAX_SECONDS=600
TRIAL_DAYS=14
ALLOW_REGISTRATION=true
