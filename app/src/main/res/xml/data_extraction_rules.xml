<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of this app goes into Google cloud backups or device-to-device transfers: the shop's records,
     the sign-in and the settings stay on this phone (owners use the app's own backup instead). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
